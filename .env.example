# Gemini API key from Google AI Studio (server-side only; never sent to browsers)
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE

# Local web server
PORT=3000

# Speaker (interpreter) authentication
# - Leave empty: only the machine running the server (localhost) can use the speaker page.
# - Set a long random value to allow speaking from other devices; the speaker page asks for it.
#   Listeners never need it.
SPEAKER_TOKEN=
